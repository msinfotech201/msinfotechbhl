rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ⚠️ Set this to the SAME email as SUPER_ADMIN_EMAIL in firebase-config.js
    // (any letter case is fine — it is compared in lowercase below).
    // This account ALWAYS has full admin access directly from this rule —
    // it does not depend on any document existing in the database, so this
    // account can never get accidentally locked out.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == "owner@gmail.com";
    }

    // True for the super admin above, OR for any email that has a document
    // in /admins (added there by an existing admin, or created automatically
    // for the super admin on first login). Always compared in lowercase so a
    // Google account's exact letter-case never causes a mismatch.
    function isAdmin() {
      return isSuperAdmin() ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    // ---- Enquiries (from the Contact page form) ----
    // Anyone visiting the site can create one (no login required).
    // Only admins can read, update (status) or delete them.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Admins list ----
    // Only admins can read, add or remove admin users.
    match /admins/{email} {
      allow read, create, update, delete: if isAdmin();
    }

    // ---- Admin login history ----
    // An admin may only write their own login record; only admins can read the log.
    match /adminLogins/{logId} {
      allow create: if isAdmin() && request.resource.data.email == request.auth.token.email.lower();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
