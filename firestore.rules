rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // True once the signed-in user's email exists as a document in /admins.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // ⚠️ Must exactly match SUPER_ADMIN_EMAIL in firebase-config.js (lowercase).
    // This only matters for the very first login, to create the first admin record.
    function isBootstrapSuperAdmin() {
      return isSignedIn() && request.auth.token.email == "owner@gmail.com";
    }

    // ---- Enquiries (from the Contact page form) ----
    // Anyone visiting the site can create one (no login required).
    // Only admins can read, update (status) or delete them.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Admins list ----
    // Only admins can read/manage the list, except the very first bootstrap
    // login, which is allowed to create its own record.
    match /admins/{email} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (isBootstrapSuperAdmin() && email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // ---- Admin login history ----
    // An admin may only write their own login record; only admins can read the log.
    match /adminLogins/{logId} {
      allow create: if isAdmin() && request.resource.data.email == request.auth.token.email
                     || (isBootstrapSuperAdmin() && request.resource.data.email == request.auth.token.email);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
